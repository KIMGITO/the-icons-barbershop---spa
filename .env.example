# The Icons Barber & Spa — Supabase Configuration
# Copy this file to `.env` and fill in your project credentials from
# Supabase Dashboard → Project Settings → API Keys

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional: Service role key for local development / admin operations only
# NEVER expose this in client bundles. Use Supabase Edge Functions instead.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY